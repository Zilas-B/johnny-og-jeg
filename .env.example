# Public — exposed to the browser
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-01
# Canonical site origin for metadata/sitemap/robots. Optional: falls back to the
# Vercel preview URL, then http://localhost:3000. Set to the custom domain at launch.
NEXT_PUBLIC_SITE_URL=

# Server-only — used in Phase B (Step 5) for drafts + revalidation
SANITY_API_EDITOR_TOKEN=
SANITY_WEBHOOK_SECRET=
